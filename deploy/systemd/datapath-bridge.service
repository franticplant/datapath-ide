# Datapath Studio bridge: serves the IDE (web/), syncs the workspace with browser tabs over /ws and
# answers MCP on POST /mcp, including the headless Icarus Verilog (WebAssembly) tools.
#
# Confinement, outermost first:
#   network    no network namespace of its own (PrivateNetwork); only the socket systemd hands over
#   identity   throwaway UID (DynamicUser) inside a user namespace, no capabilities, NoNewPrivileges
#   files      whole OS read-only, /home /root /srv /mnt /media and the rest of /opt hidden;
#              writable: the workspace only; exec: /usr/bin/node and system libraries only
#   kernel     tunables/modules/logs/clock/hostname/cgroups protected, no namespaces, no realtime
#   syscalls   seccomp allowlist @system-service minus privileged/resource/mount/debug groups
#   MAC        own SELinux domain datapath_bridge_t (drop-in selinux.conf, installed with the policy)
#   limits     memory, tasks, CPU, file descriptors
# Check with: systemd-analyze security datapath-bridge.service
[Unit]
Description=Datapath Studio sync bridge (IDE + workspace sync + MCP)
Documentation=file:///opt/datapath-studio/current/deploy/README.md
Requires=datapath-bridge.socket
After=datapath-bridge.socket

[Service]
Type=simple
# --disallow-code-generation-from-strings: no eval()/new Function() (the bridge and engine need neither).
ExecStart=/usr/bin/node --disallow-code-generation-from-strings --max-old-space-size=384 \
  /opt/datapath-studio/current/server/bridge.mjs \
  --dir /var/lib/datapath-bridge/workspace \
  --web /opt/datapath-studio/current/web \
  --poll-ms 1000
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

# Token: encrypted at rest with the host key (or the TPM, where systemd-creds finds one); decrypted by PID 1 into a private
# ramfs only this service can read. The bridge picks up $CREDENTIALS_DIRECTORY/bridge-token itself
# and never logs it.
LoadCredentialEncrypted=bridge-token:/etc/credstore.encrypted/datapath-bridge.token

# ---------------------------------------------------------------------------------- identity
DynamicUser=yes
PrivateUsers=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SecureBits=noroot-locked
UMask=0077
KeyringMode=private

# ---------------------------------------------------------------------------------- network
# Inbound only: the socket from datapath-bridge.socket. No interfaces, no loopback of the host, no
# outbound connections, no DNS. socket() may only create AF_UNIX (accept() on the inherited TCP
# socket is unaffected).
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any

# ---------------------------------------------------------------------------------- filesystem
StateDirectory=datapath-bridge
StateDirectoryMode=0700
WorkingDirectory=/var/lib/datapath-bridge
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
TemporaryFileSystem=/opt:ro /srv:ro /mnt:ro /media:ro
BindReadOnlyPaths=/opt/datapath-studio
InaccessiblePaths=-/etc/ssh -/etc/credstore -/etc/credstore.encrypted -/var/lib/tailscale -/var/lib/systemd/credential.secret
# Nothing the service can write (workspace, /tmp) or read from /opt is ever executable.
NoExecPaths=/
ExecPaths=/usr/bin /usr/lib64 /usr/lib
ProtectProc=invisible
ProcSubset=pid

# ---------------------------------------------------------------------------------- kernel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
DevicePolicy=closed

# ---------------------------------------------------------------------------------- syscalls
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @module @clock
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute stays off: V8's JIT (and so WebAssembly, which the headless Icarus tools
# need) maps writable+executable code pages. For a stricter, JIT-free bridge without the
# simulate/elaborate tools, install jitless.conf as a drop-in (see deploy/README.md).
MemoryDenyWriteExecute=no

# ---------------------------------------------------------------------------------- limits
MemoryHigh=512M
MemoryMax=768M
MemorySwapMax=0
TasksMax=32
CPUQuota=200%
LimitNOFILE=1024
LimitCORE=0

[Install]
# Started on demand by the socket; no WantedBy needed.
