+      ++vvp_used;
+
+      int ret_cd = compile_design(design_path);
+      destroy_lexor();
+      print_vpi_call_errors();
+      if (ret_cd) return ret_cd;
+
+      compile_cleanup();
+
+      if (compile_errors > 0) {
+	    vpi_mcd_printf(1, "%s: Program not runnable, %u errors.\n",
+		    design_path, compile_errors);
+	    return compile_errors;
+      }
+      return 0;
+}
